<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Procent- och Decimalmästaren</title>
    
    <!-- Tailwind CSS för styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- React och ReactDOM -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    
    <!-- Babel för att kunna köra React-kod direkt i webbläsaren -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

    <style>
      body {
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }
      @keyframes fall {
        0% { transform: translateY(-10vh) rotate(0deg); opacity: 1; }
        100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
      }
      .animate-fall {
        animation: fall 3s linear forwards;
      }
      @keyframes popIn {
        0% { transform: scale(0.5); opacity: 0; }
        80% { transform: scale(1.1); opacity: 1; }
        100% { transform: scale(1); opacity: 1; }
      }
      .animate-pop {
        animation: popIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
      }
    </style>
</head>
<body class="bg-slate-50">
    <div id="root"></div>

    <script type="text/babel">
      const { useState, useEffect, useRef } = React;

      // --- SVG Ikoner (ersätter externa bibliotek för att filen ska vara helt fristående) ---
      const Star = ({ className, fill = "none" }) => (<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill={fill} stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>);
      const Award = ({ className, fill = "none" }) => (<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill={fill} stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>);
      const Zap = ({ className, fill = "none" }) => (<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill={fill} stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>);
      const CheckCircle = ({ className }) => (<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>);
      const XCircle = ({ className }) => (<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>);
      const Info = ({ className }) => (<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>);
      const ArrowRightLeft = ({ className }) => (<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/></svg>);
      const Trophy = ({ className }) => (<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>);

      // --- Konfetti-komponent för flashig effekt ---
      const Confetti = () => {
        const colors = ['#ef4444', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899'];
        return (
          <div className="fixed inset-0 pointer-events-none z-50 overflow-hidden">
            {Array.from({ length: 60 }).map((_, i) => {
              const left = Math.random() * 100;
              const animationDelay = Math.random() * 1.5;
              const animationDuration = 2 + Math.random() * 2;
              const color = colors[Math.floor(Math.random() * colors.length)];
              const size = Math.random() * 10 + 8;
              
              return (
                <div
                  key={i}
                  className="absolute animate-fall rounded-sm shadow-sm"
                  style={{
                    left: `${left}%`,
                    backgroundColor: color,
                    width: `${size}px`,
                    height: `${size}px`,
                    animationDelay: `${animationDelay}s`,
                    animationDuration: `${animationDuration}s`,
                    top: '-20px'
                  }}
                />
              );
            })}
          </div>
        );
      };

      // --- Huvudapplikation ---
      function App() {
        const [level, setLevel] = useState(1);
        const [streak, setStreak] = useState(0);
        const [question, setQuestion] = useState(null);
        const [inputValue, setInputValue] = useState("");
        const [feedback, setFeedback] = useState({ status: 'idle', message: '' });
        const [showLevelUp, setShowLevelUp] = useState(false);
        const inputRef = useRef(null);

        // Generera en ny fråga baserat på aktuell nivå
        const generateQuestion = (currentLevel) => {
          const isToPercent = Math.random() > 0.5;
          let baseValue; 
          
          if (currentLevel === 1) {
            // Nivå 1: Endast tiotal
            baseValue = (Math.floor(Math.random() * 9) + 1) * 10;
          } else if (currentLevel === 2) {
            // Nivå 2: Heltal 1-99
            do {
              baseValue = Math.floor(Math.random() * 99) + 1;
            } while (baseValue % 10 === 0);
          } else {
            // Nivå 3: Decimaltal med en decimal
            do {
              baseValue = (Math.floor(Math.random() * 999) + 1) / 10;
            } while (Number.isInteger(baseValue));
          }

          let displayStr;
          let expectedValue;

          if (isToPercent) {
            const decValue = baseValue / 100;
            if (currentLevel === 1 || currentLevel === 2) {
              displayStr = decValue.toLocaleString('sv-SE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            } else {
              displayStr = decValue.toLocaleString('sv-SE', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
            }
            return {
              type: 'toPercent',
              display: displayStr,
              expectedValue: baseValue,
              correctAnswerStr: baseValue.toLocaleString('sv-SE') + ' %',
              unit: '%'
            };
          } else {
            displayStr = baseValue.toLocaleString('sv-SE') + ' %';
            expectedValue = baseValue / 100;
            return {
              type: 'toDecimal',
              display: displayStr,
              expectedValue: expectedValue,
              correctAnswerStr: expectedValue.toLocaleString('sv-SE', { maximumFractionDigits: 4 }),
              unit: ''
            };
          }
        };

        useEffect(() => {
          setQuestion(generateQuestion(1));
        }, []);

        useEffect(() => {
          if (feedback.status === 'idle' && inputRef.current && !showLevelUp) {
            inputRef.current.focus();
          }
        }, [question, feedback.status, showLevelUp]);

        const handleNextLevel = () => {
          setShowLevelUp(true);
          setFeedback({ status: 'idle', message: '' });
          
          setTimeout(() => {
            const nextLevel = level + 1;
            setLevel(nextLevel);
            setStreak(0);
            setQuestion(generateQuestion(nextLevel));
            setInputValue("");
            setShowLevelUp(false);
          }, 3500);
        };

        const handleNextQuestion = () => {
          setQuestion(generateQuestion(level));
          setInputValue("");
          setFeedback({ status: 'idle', message: '' });
        };

        const handleSubmit = (e) => {
          e.preventDefault();
          if (feedback.status !== 'idle' || !inputValue.trim()) return;

          let cleanedInput = inputValue.replace(/%/g, '').replace(/\s/g, '');
          cleanedInput = cleanedInput.replace(',', '.'); 
          const parsedInput = parseFloat(cleanedInput);

          if (isNaN(parsedInput)) {
            setFeedback({ status: 'incorrect', message: 'Skriv in ett giltigt nummer!' });
            setStreak(0);
            return;
          }

          const isCorrect = Math.abs(parsedInput - question.expectedValue) < 0.0001;

          if (isCorrect) {
            const newStreak = streak + 1;
            setFeedback({ status: 'correct', message: 'Snyggt jobbat! Rätt svar.' });
            setStreak(newStreak);

            if (newStreak >= 5 && level < 3) {
              setTimeout(handleNextLevel, 1000);
            } else {
              setTimeout(handleNextQuestion, 1500);
            }
          } else {
            setFeedback({ 
              status: 'incorrect', 
              message: `Tyvärr fel. Rätt svar var ${question.correctAnswerStr}. Din rad nollställdes.` 
            });
            setStreak(0);
            setTimeout(handleNextQuestion, 3500);
          }
        };

        const getLevelColor = () => {
          if (level === 1) return 'bg-emerald-500';
          if (level === 2) return 'bg-blue-500';
          return 'bg-purple-600';
        };

        const getLevelName = () => {
          if (level === 1) return 'Nivå 1: Nybörjare';
          if (level === 2) return 'Nivå 2: Lärling';
          return 'Nivå 3: Mästare';
        };

        if (!question) return null;

        return (
          <div className="min-h-screen bg-slate-50 flex flex-col items-center justify-center py-4 px-4 font-sans">
            
            {/* Level Up Overlay */}
            {showLevelUp && (
              <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm">
                <Confetti />
                <div className="bg-white rounded-3xl p-8 text-center shadow-2xl animate-pop max-w-sm mx-4">
                  <Trophy className="w-20 h-20 text-yellow-400 mx-auto mb-3" />
                  <h2 className="text-3xl font-extrabold text-slate-800 mb-2">NIVÅ UPP!</h2>
                  <p className="text-base text-slate-600 mb-5">Du klarade 5 i rad och går nu vidare till en svårare nivå!</p>
                  <div className="animate-pulse text-indigo-500 font-bold text-lg">
                    Gör dig redo...
                  </div>
                </div>
              </div>
            )}

            {/* Header */}
            <div className="max-w-5xl w-full flex items-center justify-between mb-4 lg:mb-6">
              <div>
                <h1 className="text-2xl sm:text-3xl font-extrabold text-slate-800 tracking-tight">
                  Omvandlingsmästaren
                </h1>
                <p className="text-sm sm:text-base text-slate-500 mt-1">Träna på decimal- och procentform</p>
              </div>
            </div>

            {/* Huvudlayout - Grid/Flex för Spelyta och Minnesregel */}
            <div className="max-w-5xl w-full flex flex-col lg:flex-row gap-6 items-start justify-center">

              {/* Spelyta (Vänster) */}
              <div className="w-full lg:flex-1 max-w-xl bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-100">
                
                {/* Status Bar */}
                <div className={`${getLevelColor()} p-3 sm:p-4 text-white flex justify-between items-center transition-colors duration-500`}>
                  <div className="flex items-center gap-2 font-bold text-base sm:text-lg">
                    {level === 1 && <Star className="w-5 h-5" fill="currentColor" />}
                    {level === 2 && <Award className="w-5 h-5" fill="currentColor" />}
                    {level === 3 && <Zap className="w-5 h-5" fill="currentColor" />}
                    {getLevelName()}
                  </div>
                  <div className="bg-white/20 px-3 py-1 rounded-full font-semibold text-xs sm:text-sm">
                    Mål: 5 i rad
                  </div>
                </div>

                <div className="p-5 sm:p-8">
                  
                  {/* Streak Indicator */}
                  <div className="flex justify-center gap-2 mb-6">
                    {Array.from({ length: 5 }).map((_, i) => (
                      <div 
                        key={i} 
                        className={`w-8 sm:w-10 h-2 sm:h-3 rounded-full transition-all duration-300 ${
                          i < streak ? getLevelColor() + ' scale-100' : 'bg-slate-200 scale-95'
                        }`}
                      />
                    ))}
                  </div>

                  {/* Frågan */}
                  <div className="text-center mb-6">
                    <p className="text-slate-500 font-medium mb-1 uppercase tracking-wider text-xs sm:text-sm">Din uppgift</p>
                    <h3 className="text-xl sm:text-3xl font-medium text-slate-800">
                      Omvandla <strong className="font-extrabold text-slate-900 bg-slate-100 px-3 py-1 rounded-lg inline-block mx-1 shadow-sm">{question.display}</strong>
                    </h3>
                    <p className="text-lg sm:text-xl text-slate-600 mt-2">
                      till {question.type === 'toPercent' ? 'procentform' : 'decimalform'}
                    </p>
                  </div>

                  {/* Inmatning */}
                  <form onSubmit={handleSubmit} className="flex justify-center mb-6">
                    <div className="relative flex items-center w-full max-w-[260px] sm:max-w-[300px]">
                      <input
                        ref={inputRef}
                        type="text"
                        value={inputValue}
                        onChange={(e) => setInputValue(e.target.value)}
                        disabled={feedback.status !== 'idle'}
                        placeholder="Skriv ditt svar..."
                        className={`text-center text-xl sm:text-2xl font-bold text-slate-800 w-full p-3 sm:p-4 rounded-2xl border-4 outline-none transition-all
                          ${feedback.status === 'idle' ? 'border-slate-200 focus:border-blue-400 bg-white' : ''}
                          ${feedback.status === 'correct' ? 'border-green-400 bg-green-50' : ''}
                          ${feedback.status === 'incorrect' ? 'border-red-400 bg-red-50' : ''}
                        `}
                        autoComplete="off"
                      />
                      {question.unit && (
                        <span className="absolute right-4 text-xl sm:text-2xl font-bold text-slate-400 pointer-events-none">
                          {question.unit}
                        </span>
                      )}
                    </div>
                  </form>

                  {/* Knapp */}
                  {feedback.status === 'idle' && (
                    <button 
                      onClick={handleSubmit}
                      className={`${getLevelColor()} hover:opacity-90 text-white w-full py-3 sm:py-4 rounded-2xl font-bold text-lg sm:text-xl transition-all active:scale-[0.98] shadow-md`}
                    >
                      Svara
                    </button>
                  )}

                  {/* Feedback */}
                  {feedback.status !== 'idle' && (
                    <div className={`p-4 rounded-2xl flex items-center justify-center gap-3 animate-pop
                      ${feedback.status === 'correct' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}
                    `}>
                      {feedback.status === 'correct' ? (
                        <CheckCircle className="w-6 h-6 sm:w-8 sm:h-8 text-green-600" />
                      ) : (
                        <XCircle className="w-6 h-6 sm:w-8 sm:h-8 text-red-600" />
                      )}
                      <span className="font-bold text-base sm:text-lg">
                        {feedback.message}
                      </span>
                    </div>
                  )}

                </div>
              </div>

              {/* Stödruta (Höger) */}
              <div className="w-full lg:w-[320px] xl:w-[360px] shrink-0 bg-blue-50 border-2 border-blue-200 rounded-2xl p-4 sm:p-5 shadow-sm">
                <div className="flex items-center gap-2 mb-3 text-blue-800">
                  <Info className="w-5 h-5 sm:w-6 sm:h-6 text-blue-500" />
                  <h2 className="text-lg sm:text-xl font-bold">💡 Minnesregel</h2>
                </div>
                <div className="flex flex-col gap-3 text-slate-700 text-sm sm:text-base">
                  <div className="bg-white p-3 sm:p-4 rounded-xl shadow-sm border border-blue-100 flex flex-col">
                    <span className="font-bold text-slate-800 mb-1 flex items-center gap-2">
                      Decimal <ArrowRightLeft className="w-3 h-3 sm:w-4 sm:h-4 text-blue-400" /> Procent
                    </span>
                    <span>När du går från decimalform till procentform, <strong>multiplicera med 100</strong>.</span>
                    <span className="text-blue-600 mt-2 text-xs sm:text-sm">👉 Flytta kommat två steg åt <strong>höger</strong>.</span>
                  </div>
                  <div className="bg-white p-3 sm:p-4 rounded-xl shadow-sm border border-blue-100 flex flex-col">
                    <span className="font-bold text-slate-800 mb-1 flex items-center gap-2">
                      Procent <ArrowRightLeft className="w-3 h-3 sm:w-4 sm:h-4 text-blue-400" /> Decimal
                    </span>
                    <span>När du går från procentform till decimalform, <strong>dividera med 100</strong>.</span>
                    <span className="text-blue-600 mt-2 text-xs sm:text-sm">👈 Flytta kommat två steg åt <strong>vänster</strong>.</span>
                  </div>
                </div>
              </div>

            </div> {/* Slut Layout */}

          </div>
        );
      }

      // Starta applikationen
      const root = ReactDOM.createRoot(document.getElementById('root'));
      root.render(<App />);
    </script>
</body>
</html>
